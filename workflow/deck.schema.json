{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HIROMU1015/BentoSlide0/workflow/deck.schema.json",
  "title": "BentoSlide local workflow state v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "sources", "authoring", "workflow", "approvals", "sections", "chapters", "handoff", "outputs", "preview", "validation", "migration"],
  "properties": {
    "schemaVersion": {"const": 2},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "request", "primarySource", "supplementarySources"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "title": {"type": ["string", "null"]},
        "request": {"type": "string", "minLength": 1},
        "primarySource": {"type": ["string", "null"]},
        "supplementarySources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "authorityMode"],
      "properties": {
        "manifest": {"type": "string", "minLength": 1},
        "authorityMode": {"enum": ["single", "multiple", "imported"]}
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "entryHtml", "registry", "currentSection"],
      "properties": {
        "mode": {"enum": ["single", "modular", "imported"]},
        "strategy": {"enum": ["whole_deck", "rolling_sections"]},
        "entryHtml": {"type": ["string", "null"], "minLength": 1},
        "registry": {"type": ["string", "null"], "minLength": 1},
        "currentSection": {"type": ["string", "null"]},
        "htmlChange": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "format", "proposalId", "status", "baseHtmlRevision", "baseRegistryRevision",
            "candidateHtml", "candidateRegistry", "candidateHtmlRevision", "candidateRegistryRevision",
            "proposalPath", "request", "summary", "impactSummary", "scope",
            "proposalDigest", "approvedProposalDigest", "postApplyReview",
            "requestedSlideIds", "relatedSlideIds", "changedSlideIds", "affectedSlideIds",
            "addedSlideIds", "removedSlideIds", "changedSectionIds", "slideTitles",
            "reordered", "sectionMembershipChanged", "structuralImpact", "globalStyleChanged",
            "registryChanged", "proposedAt", "approvedAt", "appliedAt", "cancelledAt"
          ],
          "properties": {
            "format": {"const": "bento/html-change-proposal/v2"},
            "proposalId": {"type": "string", "pattern": "^[a-f0-9]{12}$"},
            "status": {"enum": ["proposed", "approved", "applied", "cancelled"]},
            "baseHtmlRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "baseRegistryRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "candidateHtml": {"type": "string", "minLength": 1},
            "candidateRegistry": {"type": "string", "minLength": 1},
            "candidateHtmlRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "candidateRegistryRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "proposalPath": {"type": "string", "minLength": 1},
            "request": {"type": "string", "minLength": 1},
            "summary": {"type": "string", "minLength": 1},
            "impactSummary": {"type": "string", "minLength": 1},
            "proposalDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "approvedProposalDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "scope": {"enum": ["local", "related", "global"]},
            "requestedSlideIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "relatedSlideIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "changedSlideIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "affectedSlideIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "addedSlideIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "removedSlideIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "changedSectionIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "slideTitles": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
            "reordered": {"type": "boolean"},
            "sectionMembershipChanged": {"type": "boolean"},
            "structuralImpact": {"type": "boolean"},
            "globalStyleChanged": {"type": "boolean"},
            "registryChanged": {"type": "boolean"},
            "postApplyReview": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": [
                "format", "status", "proposalDigest", "htmlRevision", "registryRevision",
                "affectedSlideIds", "reportPath", "reportRevision", "environmentPath",
                "environmentRevision", "browserEnvironmentDigest", "screenshots", "checkedAt"
              ],
              "properties": {
                "format": {"const": "bento/html-change-post-apply-review/v1"},
                "status": {"enum": ["pending", "checked"]},
                "proposalDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "htmlRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "registryRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "affectedSlideIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                "reportPath": {"type": "string", "minLength": 1},
                "reportRevision": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
                "environmentPath": {"type": "string", "minLength": 1},
                "environmentRevision": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
                "browserEnvironmentDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
                "screenshots": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "revision"],
                    "properties": {
                      "path": {"type": "string", "minLength": 1},
                      "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
                    }
                  }
                },
                "checkedAt": {"type": ["string", "null"], "format": "date-time"}
              }
            },
            "proposedAt": {"type": "string", "format": "date-time"},
            "approvedAt": {"type": ["string", "null"], "format": "date-time"},
            "appliedAt": {"type": ["string", "null"], "format": "date-time"},
            "cancelledAt": {"type": ["string", "null"], "format": "date-time"}
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "owner", "sourceOfTruth", "currentChapter", "currentSection", "blockingReason", "blockedFrom"],
      "properties": {
        "stage": {"enum": ["initialized", "planning", "awaiting_plan_approval", "html_authoring", "html_review", "ready_for_conversion", "converting", "bento_validation", "bento_authoring", "content_review", "bento_finalization", "complete", "blocked"]},
        "status": {"enum": ["pending", "in_progress", "awaiting_approval", "ready", "blocked", "complete"]},
        "owner": {"enum": ["work", "codex"]},
        "sourceOfTruth": {"enum": ["sources", "planning", "html", "generated", "authoring", "final"]},
        "currentChapter": {"type": ["string", "null"]},
        "currentSection": {"type": ["string", "null"]},
        "blockingReason": {"type": ["string", "null"], "minLength": 1},
        "blockedFrom": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["stage", "status", "owner", "sourceOfTruth", "currentChapter", "currentSection"],
          "properties": {
            "stage": {"enum": ["initialized", "planning", "awaiting_plan_approval", "html_authoring", "html_review", "ready_for_conversion", "converting", "bento_validation", "bento_authoring", "content_review", "bento_finalization"]},
            "status": {"enum": ["pending", "in_progress", "awaiting_approval", "ready", "blocked", "complete"]},
            "owner": {"enum": ["work", "codex"]},
            "sourceOfTruth": {"enum": ["sources", "planning", "html", "generated", "authoring", "final"]},
            "currentChapter": {"type": ["string", "null"]},
            "currentSection": {"type": ["string", "null"]}
          }
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explanationPolicy", "storyOutline", "slidePlan", "bentoContent", "finalBento"],
      "properties": {
        "explanationPolicy": {"enum": ["pending", "approved"]},
        "storyOutline": {"enum": ["pending", "approved"]},
        "slidePlan": {"enum": ["pending", "approved"]},
        "bentoContent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "documentRevision", "registryRevision", "approvalDigest", "approvedAt"],
          "properties": {
            "status": {"enum": ["pending", "approved"]},
            "documentRevision": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "registryRevision": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "approvalDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "approvedAt": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "finalBento": {
          "oneOf": [
            {"enum": ["pending", "approved"]},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "documentRevision", "htmlRevision", "registryRevision", "runtimeFingerprint", "approvedAt"],
              "properties": {
                "status": {"enum": ["pending", "approved"]},
                "documentRevision": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
                "htmlRevision": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
                "registryRevision": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
                "runtimeFingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
                "approvedAt": {"type": ["string", "null"], "format": "date-time"}
              }
            }
          ]
        }
      }
    },
    "sections": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "status", "slideIds", "approvalDigest"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "authoring", "review", "approved", "html_authoring", "html_review", "bento_integration", "bento_authoring", "accepted"]},
          "canonical": {"enum": ["planning", "html", "bento"]},
          "slideIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "bentoSlideIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "approvalDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "bentoDocumentRevision": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "bentoRegistryRevision": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "bentoSectionDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "acceptedAt": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "chapters": {
      "type": "object",
      "propertyNames": {"pattern": "^chapter-[0-9]{2,}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["html", "registry", "status", "visualApproval"],
        "properties": {
          "html": {"type": "string", "minLength": 1},
          "registry": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "authoring", "review", "complete"]},
          "visualApproval": {"enum": ["pending", "approved"]}
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readyForCodex", "readyForBentoAuthoring", "readyForContentReview", "readyForFinalEditing"],
      "properties": {
        "readyForCodex": {"type": "boolean"},
        "readyForBentoAuthoring": {"type": "boolean"},
        "readyForContentReview": {"type": "boolean"},
        "readyForFinalEditing": {"type": "boolean"}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedHtml", "generatedJson", "generatedRegistry", "authoringHtml", "authoringJson", "authoringRegistry", "finalHtml", "finalJson", "finalRegistry"],
      "properties": {
        "generatedHtml": {"type": "string", "minLength": 1},
        "generatedJson": {"type": "string", "minLength": 1},
        "generatedRegistry": {"type": "string", "minLength": 1},
        "authoringHtml": {"type": ["string", "null"], "minLength": 1},
        "authoringJson": {"type": ["string", "null"], "minLength": 1},
        "authoringRegistry": {"type": ["string", "null"], "minLength": 1},
        "finalHtml": {"type": "string", "minLength": 1},
        "finalJson": {"type": "string", "minLength": 1},
        "finalRegistry": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["htmlPort", "bentoPort", "currentUrl"],
      "properties": {
        "htmlPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "bentoPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "currentUrl": {"type": ["string", "null"], "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}/$"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finalStatus", "checkedAt", "finalBaseline"],
      "properties": {
        "finalStatus": {"enum": ["pending", "pass", "fail"]},
        "checkedAt": {"type": ["string", "null"], "format": "date-time"},
        "finalBaseline": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["documentPath", "documentRevision", "registryPath", "registryRevision", "protectedContentFingerprint"],
          "properties": {
            "documentPath": {"type": "string", "minLength": 1},
            "documentRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "registryPath": {"type": "string", "minLength": 1},
            "registryRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "protectedContentFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromSchemaVersion", "migratedAt", "lateStageCompatibility"],
      "properties": {
        "fromSchemaVersion": {"type": ["integer", "null"], "minimum": 1},
        "migratedAt": {"type": ["string", "null"], "format": "date-time"},
        "lateStageCompatibility": {"type": "boolean"}
      }
    }
  }
}
